# Copy this file to .env and fill in your key. NEVER commit .env.
OPENAI_API_KEY=sk-...

# Model names change quickly (several 2024-2025 models are being retired).
# Check https://developers.openai.com/api/docs/models before choosing.
# Pick a model that accepts Temperature/Top-P (see copywriter/capabilities.py).
OPENAI_MODEL=gpt-6-luna

# Optional: only set if you need a non-default value.
# OPENAI_BASE_URL=
# OPENAI_REASONING_EFFORT=none        # none | minimal | low | medium | high | xhigh | max
# OUTPUT_FORMAT_MODE=json_schema      # json_schema | json_object | prompt_only
# LLM_BACKEND=openai                  # openai | mock (mock = offline demo, not a real model)
# MAX_CONCURRENCY=5
# MAX_RETRIES=4
# REQUEST_TIMEOUT_S=60
